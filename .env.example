# ==============================================================================
# SISTEMA INTEGRAL DE SUPERMERCADO SUPERAHORRO S.A.
# Variables de Entorno de Configuración
# ==============================================================================

# Configuración de Supabase (PostgreSQL en la Nube)
# Obtén estos valores en tu consola de Supabase: https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-public-key-aqui
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key-aqui

# Configuración General del Sistema
NEXT_PUBLIC_APP_NAME=SuperAhorro S.A.
NEXT_PUBLIC_CURRENCY_SYMBOL=Q
NEXT_PUBLIC_DEFAULT_IVA=12
NEXT_PUBLIC_APP_URL=http://localhost:3000
